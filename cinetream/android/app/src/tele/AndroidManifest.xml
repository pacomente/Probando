<?xml version="1.0" encoding="utf-8"?>
<!-- Versión para Android TV / Google TV: aparece en el inicio de la tele y se maneja con el control remoto -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.software.leanback" android:required="true" tools:replace="android:required" />

    <application android:banner="@drawable/banner">
        <activity
            android:name=".MainActivity"
            android:screenOrientation="landscape"
            tools:ignore="DiscouragedApi">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
