<?xml version="1.0" encoding="utf-8"?>
<!-- El servidor de Cinetream en casa suele ser http://192.168.x.x:3500 (sin https), por eso se permite http -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
