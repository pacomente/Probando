# ===== Trappi a bordo · Trappi Tecnología =====
# Configuración de la PC del barco. Las líneas que empiezan con # son comentarios.

# --- Trappi Central (por Starlink o 4G) ---
# Dirección de la central y clave del barco (la da Trappi Tecnología al registrar el buque)
TRAPPI_CENTRAL_URL=
TRAPPI_TOKEN=
# Cada cuántos segundos se envía la posición a la oficina
TRAPPI_INTERVALO_SEG=60

# --- Equipos del barco (funcionan SIN internet) ---
# GPS y/o AIS conectados por USB o serie. En Windows: COM3:4800 (GPS) o COM4:38400 (AIS). Varios separados por coma.
SERIAL=
# Multiplexor o receptor que envía NMEA por la red del barco
AIS_UDP_PORT=
AIS_TCP=

# --- AIS de estaciones en tierra (necesita internet) ---
# Clave gratuita de https://aisstream.io y zona a escuchar: latSur,lonOeste,latNorte,lonEste
AISSTREAM_API_KEY=
# Por defecto: todo el Mar Argentino, el Río de la Plata y el Paraná. Ejemplo solo ría de Bahía Blanca: -39.6,-62.6,-38.6,-60.9
AIS_ZONA=-56.5,-70.5,-31.3,-52

# Sin ninguna fuente configurada, la carta muestra buques SIMULADOS de práctica (marcados como tales).

# --- Pantalla ---
PORT=3001
# 127.0.0.1 = solo esta PC. 0.0.0.0 = también otras pantallas o tablets de la red del barco.
HOST=127.0.0.1
