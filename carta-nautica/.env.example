# Clave gratuita de https://aisstream.io (Sign in → API Keys). Necesita internet.
AISSTREAM_API_KEY=

# Receptor AIS a bordo (funciona SIN internet). Usá uno o los dos:
# - UDP: el receptor (dAISy, AIS-catcher, rtl-ais, OpenCPN…) envía NMEA a este puerto
AIS_UDP_PORT=
# - TCP: dirección del receptor o multiplexor que sirve NMEA, por ejemplo 192.168.1.50:10110
AIS_TCP=

# Sin ninguna fuente, la carta muestra buques SIMULADOS de práctica (marcados como tales).

# Puerto de la página web
PORT=3001
