# ===== Trappi Central · Trappi Tecnología =====
# Copiá este archivo como .env.central en el servidor.

# Puerto interno (detrás de un proxy con HTTPS, por ejemplo Caddy o nginx)
PORT=3100
# Carpeta donde se guardan cuentas, historial y alertas (hacé copias de seguridad)
CARPETA_DATOS=./datos-central
# 1 si el servidor se publica con HTTPS (las cookies de sesión se marcan como seguras)
HTTPS=1
